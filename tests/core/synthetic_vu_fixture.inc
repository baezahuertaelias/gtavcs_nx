static void nxRegisterSyntheticVuPieces()
{
        // [gta-recomp] Strict Switch CPU baseline: retain the exact-range MADD/MSUB
        // checks and all VF/VI/ACC stall/ready/settle bookkeeping. The throughput
        // variant can change overflow results and finish earlier than the fast interpreter.
#if defined(__SWITCH__) || defined(PS2X_VU1_COMPILED_PRECISE)
        vu1RegisterCompiledPieces(vu1c_pieces, sizeof(vu1c_pieces) / sizeof(vu1c_pieces[0]));
#else
        const char *fast = std::getenv("PS2X_VU1_FAST"); // throughput variant: no stall/ready bookkeeping, plain MADD
        if (!(fast && fast[0] == '0')) // default on; PS2X_VU1_FAST=0 = the cycle-exact variant
            vu1RegisterCompiledPieces(vu1c_pieces_t, sizeof(vu1c_pieces_t) / sizeof(vu1c_pieces_t[0]));
        else
            vu1RegisterCompiledPieces(vu1c_pieces, sizeof(vu1c_pieces) / sizeof(vu1c_pieces[0]));
#endif
}
}


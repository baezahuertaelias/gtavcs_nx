+    bool setChoices(const std::string &key, std::vector<Choice> choices, int defaultValue, const std::string &help)
+    {
+        auto it = g_index.find(key);
+        if (it == g_index.end() || g_specs[it->second].type != Type::Choice ||
+            std::none_of(choices.begin(), choices.end(), [&](const Choice &c) { return c.value == defaultValue; }))
+            return false;
+        Spec &s = g_specs[it->second];
+        s.choices = std::move(choices);
+        s.defaultValue = defaultValue;
+        if (!help.empty())
+            s.help = help;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_values[key] = defaultValue;
+        return true;
+    }

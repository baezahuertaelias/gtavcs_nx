index 0000000..ecd1cae
--- /dev/null
+++ b/third_party/PS2Recomp/ps2xIOP/include/ps2x/iop/detail/cdvd_directory.h
@@ -0,0 +1,68 @@
+// [gta-recomp] Checked directory layout shared by the virtual CDVD writer and
+// its public boundary tests. Reject unrepresentable metadata; never truncate.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace ps2x::iop::detail::cdvd_directory {
+inline constexpr uint32_t SectorSize=2048u;
+inline constexpr uint64_t MaximumDirectoryBytes=
+    uint64_t(std::numeric_limits<uint32_t>::max()/SectorSize)*SectorSize;
+
+inline bool recordSize(size_t identifierSize,size_t &bytes) noexcept {
+    // The padded record length is stored in one byte. Production isoName()
+    // limits identifiers to 202 bytes; reject larger invalid direct inputs too.
+    if(identifierSize==0 || identifierSize>221u) return false;
+    const size_t unpadded=33u+identifierSize;
+    bytes=unpadded+(unpadded&1u);
+    return true;
+}
+inline bool advanceCursor(uint64_t &cursor,size_t identifierSize) noexcept {
+    size_t record=0;
+    if(!recordSize(identifierSize,record) || cursor>MaximumDirectoryBytes) return false;
+    const uint64_t inSector=cursor%SectorSize;
+    const uint64_t padding=inSector+record>SectorSize ? SectorSize-inSector : 0u;
+    if(padding>MaximumDirectoryBytes-cursor) return false;
+    const uint64_t begin=cursor+padding;
+    if(record>MaximumDirectoryBytes-begin) return false;
+    cursor=begin+record;
+    return true;
+}
+inline bool roundedBytes(uint64_t cursor,uint32_t &bytes) noexcept {
+    if(cursor>MaximumDirectoryBytes) return false;
+    const uint64_t rounded=(cursor+SectorSize-1u)/SectorSize*SectorSize;
+    bytes=static_cast<uint32_t>(rounded ? rounded : SectorSize);
+    return true;
+}
+inline bool advanceLsn(uint32_t &cursor,uint32_t sectors) noexcept {
+    if(sectors>std::numeric_limits<uint32_t>::max()-cursor) return false;
+    cursor+=sectors;
+    return true;
+}
+inline bool fileBytes(uint64_t size,uint32_t &bytes) noexcept {
+    if(size>std::numeric_limits<uint32_t>::max()) return false;
+    bytes=static_cast<uint32_t>(size);
+    return true;
+}
+inline size_t writeRecord(uint8_t *destination,size_t remaining,uint32_t lsn,
+                          uint32_t size,bool directory,const uint8_t *identifier,
+                          size_t identifierSize) noexcept {
+    size_t record=0;
+    if(!destination || !identifier || !recordSize(identifierSize,record) || record>remaining) return 0;
+    std::memset(destination,0,record);
+    destination[0]=static_cast<uint8_t>(record);
+    for(unsigned i=0;i<4;++i) {
+        destination[2u+i]=static_cast<uint8_t>(lsn>>(8u*i));
+        destination[6u+i]=static_cast<uint8_t>(lsn>>(8u*(3u-i)));
+        destination[10u+i]=static_cast<uint8_t>(size>>(8u*i));
+        destination[14u+i]=static_cast<uint8_t>(size>>(8u*(3u-i)));
+    }
+    destination[25]=directory?2u:0u;
+    destination[28]=1u; destination[31]=1u;
+    destination[32]=static_cast<uint8_t>(identifierSize);
+    std::memcpy(destination+33u,identifier,identifierSize);
+    return record;
+}
+}

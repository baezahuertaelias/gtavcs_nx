diff --git a/third_party/PS2Recomp/ps2xRuntime/include/ps2_runtime_macros.h b/third_party/PS2Recomp/ps2xRuntime/include/ps2_runtime_macros.h
index 9f124f4..887eadd 100644
--- a/third_party/PS2Recomp/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/third_party/PS2Recomp/ps2xRuntime/include/ps2_runtime_macros.h
@@ -844,11 +844,62 @@ inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
     return _mm_set1_epi64x(static_cast<long long>(value));
 }
 
-#define PS2_PMFHL_LW(hi, lo) _mm_unpacklo_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_UW(hi, lo) _mm_unpackhi_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_SLW(hi, lo) _mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_LH(hi, lo) _mm_shuffle_epi32(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0))
-#define PS2_PMFHL_SH(hi, lo) _mm_shufflehi_epi16(_mm_shufflelo_epi16(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0))
+// [gta-recomp] Packed HI/LO instructions read both 64-bit halves of the
+// physical 128-bit accumulators. Keep numeric conversions and lane order
+// explicit; the independent port tests use scalar architectural models.
+inline __m128i ps2_pmfhl_lw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(std::bit_cast<int32_t>(uint32_t(hi1)),
+        std::bit_cast<int32_t>(uint32_t(lo1)), std::bit_cast<int32_t>(uint32_t(hi)),
+        std::bit_cast<int32_t>(uint32_t(lo)));
+}
+inline __m128i ps2_pmfhl_uw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(std::bit_cast<int32_t>(uint32_t(hi1 >> 32)),
+        std::bit_cast<int32_t>(uint32_t(lo1 >> 32)), std::bit_cast<int32_t>(uint32_t(hi >> 32)),
+        std::bit_cast<int32_t>(uint32_t(lo >> 32)));
+}
+inline int64_t ps2_pmfhl_slw_lane(uint64_t hi, uint64_t lo)
+{
+    const uint64_t raw = (uint64_t(uint32_t(hi)) << 32) | uint32_t(lo);
+    const int64_t value = std::bit_cast<int64_t>(raw);
+    return value > INT32_MAX ? INT32_MAX : value < INT32_MIN ? INT32_MIN : value;
+}
+inline __m128i ps2_pmfhl_slw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi64x(ps2_pmfhl_slw_lane(hi1,lo1), ps2_pmfhl_slw_lane(hi,lo));
+}
+inline __m128i ps2_pmfhl_halfwords(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1, bool saturate)
+{
+    const uint32_t words[8] = {uint32_t(lo),uint32_t(lo >> 32),uint32_t(hi),uint32_t(hi >> 32),
+        uint32_t(lo1),uint32_t(lo1 >> 32),uint32_t(hi1),uint32_t(hi1 >> 32)};
+    uint16_t halves[8];
+    for (unsigned i=0;i<8;++i) {
+        const int32_t signedWord = std::bit_cast<int32_t>(words[i]);
+        halves[i] = saturate ? static_cast<uint16_t>(signedWord > INT16_MAX ? INT16_MAX :
+            signedWord < INT16_MIN ? INT16_MIN : signedWord) : uint16_t(words[i]);
+    }
+    __m128i result;
+    std::memcpy(&result,halves,sizeof(result));
+    return result;
+}
+inline __m128i ps2_pmfhl_lh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{ return ps2_pmfhl_halfwords(hi,lo,hi1,lo1,false); }
+inline __m128i ps2_pmfhl_sh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{ return ps2_pmfhl_halfwords(hi,lo,hi1,lo1,true); }
+inline void ps2_pmthl_lw(R5900Context *ctx, __m128i value)
+{
+    uint32_t words[4]; std::memcpy(words,&value,sizeof(value));
+    ctx->lo = (ctx->lo & 0xffffffff00000000ull) | words[0];
+    ctx->hi = (ctx->hi & 0xffffffff00000000ull) | words[1];
+    ctx->lo1 = (ctx->lo1 & 0xffffffff00000000ull) | words[2];
+    ctx->hi1 = (ctx->hi1 & 0xffffffff00000000ull) | words[3];
+}
+#define PS2_PMFHL_LW(hi,lo,hi1,lo1) ps2_pmfhl_lw(hi,lo,hi1,lo1)
+#define PS2_PMFHL_UW(hi,lo,hi1,lo1) ps2_pmfhl_uw(hi,lo,hi1,lo1)
+#define PS2_PMFHL_SLW(hi,lo,hi1,lo1) ps2_pmfhl_slw(hi,lo,hi1,lo1)
+#define PS2_PMFHL_LH(hi,lo,hi1,lo1) ps2_pmfhl_lh(hi,lo,hi1,lo1)
+#define PS2_PMFHL_SH(hi,lo,hi1,lo1) ps2_pmfhl_sh(hi,lo,hi1,lo1)
 
 // FPU (COP1) operations
 #define FPU_SET_ACC(ctx, res) (ctx->f_acc = res)

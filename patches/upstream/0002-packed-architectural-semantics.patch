+// [gta-recomp] Architectural halfword lanes, with rs/rt evaluated once.
+inline __m128i ps2_pinth(__m128i rs, __m128i rt)
+{
+    uint16_t a[8], b[8], out[8];
+    std::memcpy(a, &rs, sizeof(a)); std::memcpy(b, &rt, sizeof(b));
+    for (unsigned i = 0; i < 4; ++i) { out[2*i] = b[i]; out[2*i+1] = a[i+4]; }
+    __m128i result; std::memcpy(&result, out, sizeof(result)); return result;
+}
+inline __m128i ps2_pinteh(__m128i rs, __m128i rt)
+{
+    uint16_t a[8], b[8], out[8];
+    std::memcpy(a, &rs, sizeof(a)); std::memcpy(b, &rt, sizeof(b));
+    for (unsigned i = 0; i < 4; ++i) { out[2*i] = b[2*i]; out[2*i+1] = a[2*i]; }
+    __m128i result; std::memcpy(&result, out, sizeof(result)); return result;
+}
+#define PS2_PINTH(rs, rt) ps2_pinth((__m128i)(rs), (__m128i)(rt))
+#define PS2_PINTEH(rs, rt) ps2_pinteh((__m128i)(rs), (__m128i)(rt))
 
 // Packed Multiply-Add (PMADD)
 #define PS2_PMADDW(a, b) _mm_add_epi32(_mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(1, 0, 3, 2)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(1, 0, 3, 2))), _mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0))))
 
 // Packed Variable Shifts
-#define PS2_PSLLVW(a, b) _mm_custom_sllv_epi32((__m128i)(a), (__m128i)(b))
-#define PS2_PSRLVW(a, b) _mm_custom_srlv_epi32((__m128i)(a), (__m128i)(b))
-#define PS2_PSRAVW(a, b) _mm_custom_srav_epi32((__m128i)(a), (__m128i)(b))
+// [gta-recomp] EE packed variable shifts consume rs word0/2 as counts and rt
+// word0/2 as data, then sign-extend each shifted word into a 64-bit lane.
+enum class Ps2PackedWordShift { Left, LogicalRight, ArithmeticRight };
+inline __m128i ps2_shift_even_words(__m128i rs, __m128i rt, Ps2PackedWordShift mode)
+{
+    uint32_t counts[4], data[4]; uint64_t out[2];
+    std::memcpy(counts, &rs, sizeof(counts)); std::memcpy(data, &rt, sizeof(data));
+    for (unsigned i = 0; i < 2; ++i) {
+        const unsigned shift = counts[2*i] & 31u;
+        const uint32_t source = data[2*i];
+        uint32_t value = mode == Ps2PackedWordShift::Left ? source << shift : source >> shift;
+        if (mode == Ps2PackedWordShift::ArithmeticRight && shift && (source & 0x80000000u))
+            value |= UINT32_MAX << (32u - shift);
+        out[i] = static_cast<uint64_t>(static_cast<int64_t>(std::bit_cast<int32_t>(value)));
+    }
+    __m128i result; std::memcpy(&result, out, sizeof(result)); return result;
+}
+#define PS2_PSLLVW(rs, rt) ps2_shift_even_words((__m128i)(rs), (__m128i)(rt), Ps2PackedWordShift::Left)
+#define PS2_PSRLVW(rs, rt) ps2_shift_even_words((__m128i)(rs), (__m128i)(rt), Ps2PackedWordShift::LogicalRight)
+#define PS2_PSRAVW(rs, rt) ps2_shift_even_words((__m128i)(rs), (__m128i)(rt), Ps2PackedWordShift::ArithmeticRight)
 

+        // [gta-recomp] A recording is keyed by where its block lies in guest RAM, and streaming puts a model somewhere else
+        // each time its area comes back: without pruning the map only grew while driving (desktop, the null renderer: ~35 MB
+        // a minute, 26,000 recordings after 16 minutes; the Switch's heap past 1 GB after 20). Every 1,024 chains,
+        // recordings no chain used in the last kRecordingAge are dropped. Only a cache: a block whose recording is gone is
+        // recorded again (handleBlock), or a skipped one taken from guest RAM (replaySkipped).
+        void pruneRecordings(uint64_t seq)
+        {
+            constexpr uint64_t kRecordingAge = 3600u; // chains (one a game frame): a minute at 60 fps; ~8.6 min at the Switch's ~7 driving
+            if (seq < g_recordingsPrunedAt + 1024u || seq < kRecordingAge)
+                return;
+            g_recordingsPrunedAt = seq;
+            for (auto it = g_recordings.begin(); it != g_recordings.end();)
+                if (it->second.lastSeq + kRecordingAge < seq)
+                {
+                    it = g_recordings.erase(it);
+                    ++g_recordingsPruned;
+                }
+                else
+                    ++it;
+        }

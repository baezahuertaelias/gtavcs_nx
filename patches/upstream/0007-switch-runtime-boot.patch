+// [gta-recomp] The launcher's steps (main.cpp), callable by a host that owns its own start-up and main loop (the
+// Switch port's C ABI). main() calls them in this order; another host keeps the same order:
+//   registerSettings(), settings::load / applyAll, restoreWindowPlacement()
+//   setUiCallbacks(runtime)      before runtime.initialize() (initialize runs the UI init hook)
+//   runtime.initialize(), runtime.loadELF(), PS2Runtime::setIoPaths(...)
+//   installHooks(runtime)        after loadELF and the I/O paths: input, volume, trainer, rig, game info, commands
+// Building main.cpp with VCS_LAUNCHER_NO_MAIN leaves out main() and keeps these.
+#pragma once
+
+#include <filesystem>
+
+class PS2Runtime;
+
+namespace vcs::launcher
+{
+    void registerSettings();

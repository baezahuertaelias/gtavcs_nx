diff --git a/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_host_fs.h b/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_host_fs.h
new file mode 100644
index 0000000..e225acd
--- /dev/null
+++ b/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_host_fs.h
@@ -0,0 +1,94 @@
+// [gta-recomp] Host file operations whose std::filesystem form fails on the Nintendo Switch's SD card (newlib + the
+// libnx fsdev device), measured on hardware by the Switch port (M03 probe, docs/PS2RECOMP_PATCHES.md):
+//   std::filesystem::remove_all        fails with EIO on a folder holding files
+//   std::filesystem::rename onto a file that exists fails with EEXIST (POSIX and Windows replace it)
+// Elsewhere these are the std::filesystem calls themselves, so desktop behaviour does not change.
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace ps2x
+{
+    // Replaces `target` with `source` (a finished temporary file), as std::filesystem::rename does on POSIX. On the
+    // Switch a target that exists is first moved aside to <target>.old and removed after the rename; when the rename
+    // fails the old file is moved back, so the target is never lost. ec is the first failure.
+    inline void replaceFile(const std::filesystem::path &source, const std::filesystem::path &target, std::error_code &ec)
+    {
+        ec.clear();
+#if defined(__SWITCH__)
+        std::error_code probe;
+        if (!std::filesystem::exists(target, probe))
+        {
+            std::filesystem::rename(source, target, ec);
+            return;
+        }
+        std::filesystem::path aside = target;
+        aside += ".old";
+        std::filesystem::remove(aside, probe); // a leftover from an interrupted replace
+        std::filesystem::rename(target, aside, ec);
+        if (ec)
+            return;
+        std::filesystem::rename(source, target, ec);
+        if (ec)
+        {
+            std::error_code restore;
+            std::filesystem::rename(aside, target, restore);
+            return;
+        }
+        std::filesystem::remove(aside, probe);
+#else
+        std::filesystem::rename(source, target, ec);
+#endif
+    }
+
+    // Removes `root` and everything under it, as std::filesystem::remove_all. On the Switch it walks the tree itself:
+    // files first, then each folder after its contents. ec is the first failure; nothing is skipped silently.
+    inline void removeTree(const std::filesystem::path &root, std::error_code &ec)
+    {
+        ec.clear();
+#if defined(__SWITCH__)
+        std::error_code probe;
+        const std::filesystem::file_status status = std::filesystem::symlink_status(root, probe);
+        if (probe || status.type() == std::filesystem::file_type::not_found)
+            return; // nothing there, as remove_all
+        if (status.type() != std::filesystem::file_type::directory)
+        {
+            std::filesystem::remove(root, ec);
+            return;
+        }
+        std::vector<std::filesystem::path> folders;
+        std::vector<std::filesystem::path> files;
+        for (std::filesystem::recursive_directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec))
+        {
+            if (it->is_directory(probe) && !it->is_symlink(probe))
+                folders.push_back(it->path());
+            else
+                files.push_back(it->path());
+        }
+        if (ec)
+            return;
+        for (const std::filesystem::path &file : files)
+            if (!std::filesystem::remove(file, ec) || ec)
+            {
+                if (!ec)
+                    ec = std::make_error_code(std::errc::io_error);
+                return;
+            }
+        // deepest first: a folder is listed after its parent, so the reverse order empties children before parents
+        for (auto it = folders.rbegin(); it != folders.rend(); ++it)
+            if (!std::filesystem::remove(*it, ec) || ec)
+            {
+                if (!ec)
+                    ec = std::make_error_code(std::errc::io_error);
+                return;
+            }
+        if (!std::filesystem::remove(root, ec) && !ec)
+            ec = std::make_error_code(std::errc::io_error);
+#else
+        std::filesystem::remove_all(root, ec);
+#endif
+    }
+}

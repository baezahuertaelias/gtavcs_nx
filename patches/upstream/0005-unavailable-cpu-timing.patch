         ps2perf::hostFrame(std::chrono::duration<double, std::milli>(ps2x::hostNow() - uploadStart).count()); // [gta-recomp]
 
         // [gta-recomp] display aspect: 4:3 (the PS2's TV), the widescreen ratio for 3D frames (render/presenter.h)
